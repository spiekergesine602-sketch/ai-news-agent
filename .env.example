OPENAI_API_KEY=replace_with_openai_or_compatible_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
